# Upstash Redis (create at https://console.upstash.com, or via Vercel Marketplace > Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NextAuth (Google login for both employees and admin)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of admin emails allowed to sign in via Google to the admin dashboard
ADMIN_EMAILS=admin1@adda247.com,admin2@adda247.com
